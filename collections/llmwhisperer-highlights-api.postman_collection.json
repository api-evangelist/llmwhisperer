          "name": "Retrieve per-line bounding-box coordinates",
          "request": {
            "name": "Retrieve per-line bounding-box coordinates",
            "description": {
              "content": "Returns bounding-box metadata for the requested lines so callers can highlight extracted text in the source document. Requires the whisper job to have been submitted with add_line_nos enabled.",
