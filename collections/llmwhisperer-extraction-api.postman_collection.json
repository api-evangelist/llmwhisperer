          "name": "Submit a document for text extraction",
          "request": {
            "name": "Submit a document for text extraction",
            "description": {
              "content": "Converts a document to text. Accepts the raw document as binary (application/octet-stream) or, when url_in_post is true, a URL in the request body. Processing is asynchronous; a whisper_hash is returned to track and retrieve the job.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "whisper"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "mode",
                  "value": "form",
                  "description": "Extraction mode."
                },
                {
                  "disabled": false,
                  "key": "output_mode",
                  "value": "layout_preserving",
                  "description": "Output formatting mode."
                },
                {
                  "disabled": false,
                  "key": "page_seperator",
                  "value": "<<<",
                  "description": "Page delimiter string inserted between pages."
                },
                {
                  "disabled": false,
                  "key": "pages_to_extract",
                  "value": "<string>",
                  "description": "Pages to extract, e.g. \"1-5,7,21-\"."
                },
                {
                  "disabled": false,
                  "key": "median_filter_size",
                  "value": "0",
                  "description": "Median filter size for low_cost mode noise removal."
                },
                {
                  "disabled": false,
                  "key": "gaussian_blur_radius",
                  "value": "0",
                  "description": "Gaussian blur radius for low_cost mode noise removal."
                },
                {
                  "disabled": false,
                  "key": "line_splitter_tolerance",
                  "value": "0.4",
                  "description": "Baseline factor for line splitting (fraction of line height)."
                },
                {
                  "disabled": false,
                  "key": "line_splitter_strategy",
                  "value": "left-priority",
                  "description": "Line splitting strategy."
                },
                {
                  "disabled": false,
                  "key": "horizontal_stretch_factor",
                  "value": "1",
                  "description": "Horizontal stretch factor for multi-column layout adjustment."
                },
                {
                  "disabled": false,
                  "key": "url_in_post",
                  "value": "false",
                  "description": "When true, the request body is a document URL instead of binary data."
                },
                {
                  "disabled": false,
                  "key": "mark_vertical_lines",
